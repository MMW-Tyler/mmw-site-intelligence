# MMW Site Intelligence — Environment Variables
# Copy this to .env for local dev. On Render, set these in the dashboard.

# Supabase project (create a NEW project for this tool — don't reuse Content Engine's)
SUPABASE_URL=https://your-new-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Server port (Render sets this automatically; only used for local dev)
PORT=3000
